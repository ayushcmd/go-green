# ==============================================================================
# GoGreen — Polyglot Systems Engineering Laboratory
# Environment Configuration Template
# Tagline: BUILD DEEP. THINK LOW-LEVEL. ENGINEER BEYOND LIMITS.
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STUDIO FRONTEND (React 18 + Vite + TypeScript)
# ------------------------------------------------------------------------------
VITE_APP_TITLE=GoGreen Studio
VITE_CORE_ENGINE_URL=http://127.0.0.1:8080
VITE_SANDBOX_MANAGER_URL=http://127.0.0.1:8081
VITE_CONTROL_PLANE_URL=http://127.0.0.1:8082
VITE_REFRESH_INTERVAL_MS=3000

# ------------------------------------------------------------------------------
# 2. NATIVE CORE ENGINE DAEMON (C++23 + NASM x86-64)
# ------------------------------------------------------------------------------
# Binding port for the standalone C++23 HTTP micro-daemon
GOGREEN_DAEMON_PORT=8080
GOGREEN_DAEMON_HOST=127.0.0.1
# Maximum concurrency threads for native benchmark suites
GOGREEN_MAX_BENCHMARK_THREADS=8

# ------------------------------------------------------------------------------
# 3. SANDBOX SUPERVISOR (Rust Tokio Supervisor)
# ------------------------------------------------------------------------------
# REST API binding port for the hardened execution supervisor
GOGREEN_SANDBOX_PORT=8081
GOGREEN_SANDBOX_HOST=127.0.0.1
# Base directory for sandboxed execution logs, artifacts, and SHA-256 manifests
GOGREEN_ARTIFACT_DIR=dist/artifacts/executions
# Default execution resource constraints
GOGREEN_SANDBOX_DEFAULT_TIMEOUT_MS=5000
GOGREEN_SANDBOX_MAX_MEMORY_BYTES=134217728
GOGREEN_SANDBOX_MAX_CPU_PERCENT=80
GOGREEN_SANDBOX_MAX_OUTPUT_BYTES=2097152

# ------------------------------------------------------------------------------
# 4. WORKER AGENT (Go 1.23 Distributed Agent)
# ------------------------------------------------------------------------------
# Unique node identifier on the distributed mesh
GOGREEN_WORKER_ID=worker-node-alpha-01
# Host:Port of the Java Control Plane gRPC coordinator
GOGREEN_COORDINATOR_ENDPOINT=127.0.0.1:50051
# Local native C++ daemon endpoint inspected by the worker
GOGREEN_NATIVE_DAEMON_URL=http://127.0.0.1:8080
# Heartbeat transmission interval in seconds
GOGREEN_HEARTBEAT_INTERVAL=3
# Maximum gRPC message payload size in bytes (8 MB)
GOGREEN_MAX_MESSAGE_SIZE=8388608
# Security and mTLS parameters
GOGREEN_TLS_ENABLED=false
GOGREEN_MTLS_ENABLED=false
GOGREEN_TLS_CA_FILE=certs/ca.crt
GOGREEN_TLS_CERT_FILE=certs/worker.crt
GOGREEN_TLS_KEY_FILE=certs/worker.key

# ------------------------------------------------------------------------------
# 5. CONTROL PLANE (Java 25 + Spring Boot 3.4)
# ------------------------------------------------------------------------------
# Spring Boot REST management API port
PORT=8082
SERVER_PORT=8082
# Distributed mesh gRPC coordinator listen port
GOGREEN_COORDINATOR_GRPC_PORT=50051
GOGREEN_HEARTBEAT_TIMEOUT=10
GOGREEN_DEFAULT_HEARTBEAT_INTERVAL=3
# Primary scheduler partition
GOGREEN_DEFAULT_PARTITION=partition-primary

# Database persistence (Default: H2 in-memory; Production: PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:h2:mem:gogreen_mesh;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_PLATFORM=org.hibernate.dialect.H2Dialect

# Optional PostgreSQL configuration:
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/gogreen_mesh
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=gogreen_admin
# SPRING_DATASOURCE_PASSWORD=change_me_to_strong_secret
# SPRING_JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Event bus configuration (NATS JetStream)
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM_NAME=GOGREEN_MESH_EVENTS
NATS_SUBJECT_PREFIX=mesh.events
